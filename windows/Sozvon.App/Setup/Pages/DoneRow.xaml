<UserControl
    x:Class="Sozvon.App.Setup.Pages.DoneRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="RowIcon" FontSize="20" />
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="RowTitle" />
            <TextBlock x:Name="RowDetail" Style="{StaticResource SetupDetail}" />
        </StackPanel>
        <FontIcon x:Name="RowCheck" Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
    </Grid>
</UserControl>
