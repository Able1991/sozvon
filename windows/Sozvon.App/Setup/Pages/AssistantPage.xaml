<UserControl
    x:Class="Sozvon.App.Setup.Pages.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Sozvon.App.Settings">
    <StackPanel Spacing="12">
        <Border Style="{StaticResource SetupCard}" Padding="16,4">
            <StackPanel x:Name="Choices" />
        </Border>
        <settings:AssistantInstallHelp x:Name="InstallHelp" />
        <Border x:Name="SummaryLanguageCard" Style="{StaticResource SetupCard}">
            <Grid Padding="16,12">
                <TextBlock x:Name="SummaryLanguageLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="SummaryLanguageBox" AutomationProperties.AutomationId="SummaryLanguageBox" Width="220" HorizontalAlignment="Right"
                          SelectionChanged="OnSummaryLanguageChanged" />
            </Grid>
        </Border>
        <InfoBar x:Name="WarningBar" Severity="Warning" IsClosable="False" IsOpen="False" />
    </StackPanel>
</UserControl>
