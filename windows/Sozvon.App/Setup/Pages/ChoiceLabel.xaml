<UserControl
    x:Class="Sozvon.App.Setup.Pages.ChoiceLabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="NoteText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="DetailText" Style="{StaticResource SetupDetail}" />
    </StackPanel>
</UserControl>
