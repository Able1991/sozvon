<UserControl
    x:Class="Sozvon.App.Setup.Pages.ReadyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <Border Style="{StaticResource SetupCard}" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="FindButton" IsEnabled="False" />
                <TextBlock x:Name="UnavailableText" Style="{StaticResource SetupDetail}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="LaterText" Style="{StaticResource SetupDetail}" />
        <Border Style="{StaticResource SetupCard}" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="HintTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="HintText" Style="{StaticResource SetupDetail}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
