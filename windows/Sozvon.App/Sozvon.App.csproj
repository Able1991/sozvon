<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Sozvon.App</RootNamespace>
    <AssemblyName>Sozvon</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Shell\Assets\Sozvon.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sozvon.Core\Sozvon.Core.csproj" />
    <ProjectReference Include="..\Sozvon.Audio\Sozvon.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Shell\Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Sources\Sozvon\Resources\record-*.wav" Link="Shell\Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\Sources\Sozvon\Resources\en.lproj\Localizable.strings" LogicalName="mac.en.strings" />
    <EmbeddedResource Include="Strings\windows-en.strings" LogicalName="windows-en.strings" />
  </ItemGroup>
  <!-- The version as the Mac takes it (build.sh: the latest tag, without its v) and the short commit, written into the
       assembly at build time; About shows them as a preview build until Windows has releases of its own. No git: empty. -->
  <Target Name="SozvonBuildVersion" BeforeTargets="GetAssemblyAttributes;CoreGenerateAssemblyInfo">
    <Exec Command="git describe --tags --abbrev=0" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="SozvonTag" />
      <Output TaskParameter="ExitCode" PropertyName="SozvonTagExit" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="SozvonCommit" />
      <Output TaskParameter="ExitCode" PropertyName="SozvonCommitExit" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="SozvonVersion" Value="$(SozvonTag.TrimStart('v'))" Condition="'$(SozvonTagExit)' == '0'" />
      <AssemblyMetadata Include="SozvonCommit" Value="$(SozvonCommit)" Condition="'$(SozvonCommitExit)' == '0'" />
    </ItemGroup>
  </Target>
</Project>
