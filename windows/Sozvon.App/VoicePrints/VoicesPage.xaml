<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.VoicePrints.VoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Sozvon.App.Settings"
    xmlns:voices="using:Sozvon.App.VoicePrints"
    xmlns:s="using:Sozvon.App.Strings">
    <UserControl.Resources>

        <Style x:Key="Foot" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="36,24,20,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{s:L K='Голоса'}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="1000" Padding="0,0,16,24" Spacing="4">
                <settings:SettingsRow x:Name="MyVoiceRow" Margin="0,16,0,0" Header="{s:L K='Твой голос'}" />

                <Grid Margin="0,28,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Text="{s:L K='Сохранённые голоса'}" />
                    <ProgressRing x:Name="Busy" Grid.Column="1" Width="16" Height="16" Margin="0,0,12,0" IsActive="False" />
                    <Button x:Name="DeleteAllButton" Grid.Column="2" Content="{s:L K='Удалить все…'}" Click="OnDeleteAll" />
                </Grid>
                <InfoBar x:Name="Problem" IsClosable="True" Severity="Warning" />
                <ListView x:Name="VoiceList" Margin="-12,0" SelectionMode="Single" ItemsSource="{x:Bind Rows}"
                          AutomationProperties.Name="{s:L K='Сохранённые голоса'}"
                          ContainerContentChanging="OnContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="voices:VoiceRow">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE77B;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind MeIcon}" />
                                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE716;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind OtherIcon}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Padding="8" Background="Transparent" BorderThickness="0" Tag="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind DeleteLabel}" ToolTipService.ToolTip="{x:Bind DeleteLabel}" Loaded="OnDeleteButtonLoaded">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Margin="0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="{s:L K='Пока нет: имена подставятся, когда ты подпишешь спикеров'}" />
                <TextBlock Style="{StaticResource Foot}" Margin="0,16,0,0"
                           Text="{s:L K='Отпечатки голосов относятся к биометрическим данным: они хранятся на этом компьютере. Sozvon использует их только для того, чтобы называть собеседников в твоих звонках.'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
