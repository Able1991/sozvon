<?xml version="1.0" encoding="utf-8"?>
<!-- Trim mode, as on the Mac (TrimPanel.swift): the player bar grown in place over the page. -->
<UserControl
    x:Class="Sozvon.App.Calls.TrimPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:Sozvon.App.Strings"
    KeyDown="OnKeyDown">
    <Border Padding="12,10,12,10" CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
            <!-- The waveform with the kept range, the playhead and the two handles. -->
            <Grid x:Name="WaveArea" Height="64" Margin="12,0" Background="Transparent"
                  PointerPressed="OnWavePressed" SizeChanged="OnWaveSizeChanged"
                  AutomationProperties.Name="{s:L K='Обрезка записи'}">
                <Path x:Name="CutBars" Fill="{ThemeResource TextFillColorDisabledBrush}" />
                <Path x:Name="KeptBars" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <Rectangle x:Name="CutBefore" HorizontalAlignment="Left" Fill="{ThemeResource SmokeFillColorDefaultBrush}" Opacity="0.25" IsHitTestVisible="False" />
                <Rectangle x:Name="CutAfter" HorizontalAlignment="Right" Fill="{ThemeResource SmokeFillColorDefaultBrush}" Opacity="0.25" IsHitTestVisible="False" />
                <Rectangle x:Name="Playhead" Width="2" HorizontalAlignment="Left" Fill="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                <TextBlock x:Name="WaveMessage" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ContentControl x:Name="StartHandle" Width="24" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Stretch" IsTabStop="True" UseSystemFocusVisuals="True"
                                PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleCaptureLost"
                                GotFocus="OnHandleFocused" AutomationProperties.HelpText="{s:L K='Стрелки двигают на секунду, с Shift на десять секунд'}">
                    <Border x:Name="StartKnob" Width="8" CornerRadius="4"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                </ContentControl>
                <ContentControl x:Name="EndHandle" Width="24" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Stretch" IsTabStop="True" UseSystemFocusVisuals="True"
                                PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased" PointerCaptureLost="OnHandleCaptureLost"
                                GotFocus="OnHandleFocused" AutomationProperties.HelpText="{s:L K='Стрелки двигают на секунду, с Shift на десять секунд'}">
                    <Border x:Name="EndKnob" Width="8" CornerRadius="4"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" />
                </ContentControl>
            </Grid>

            <!-- Editing: play, the end's last seconds, the times, Cancel and Trim. -->
            <Grid x:Name="EditingRow" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Width="36" Height="36" Padding="0" CornerRadius="18" Style="{ThemeResource AccentButtonStyle}" Click="OnPlay">
                    <FontIcon x:Name="PlayIcon" FontSize="14" Glyph="&#xF5B0;" />
                </Button>
                <Button x:Name="EndButton" Grid.Column="1" Click="OnListenToEnd" ToolTipService.ToolTip="{s:L K='Последние 5 секунд перед концом'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE893;" />
                        <TextBlock Text="{s:L K='Прослушать конец'}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TimesText" Grid.Column="2" Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="CancelButton" Grid.Column="3" Content="{s:L K='Отмена'}" Click="OnCancel" />
                <Button x:Name="TrimButton" Grid.Column="4" Content="{s:L K='Обрезать…'}" Style="{ThemeResource AccentButtonStyle}" Click="OnTrim" />
            </Grid>

            <!-- The confirmation, in the panel. -->
            <Grid x:Name="ConfirmRow" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConfirmText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="{s:L K='Отмена'}" Click="OnCancel" />
                <Button x:Name="ConfirmButton" Grid.Column="2" Content="{s:L K='Обрезать и расшифровать'}" Click="OnConfirm"
                        Background="{ThemeResource SystemFillColorCriticalBrush}" Foreground="White" />
            </Grid>

            <!-- The engine is cutting: nothing can be cancelled now. -->
            <StackPanel x:Name="WorkingRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <ProgressRing Width="20" Height="20" IsActive="True" />
                <TextBlock VerticalAlignment="Center" Text="{s:L K='Обрезаю…'}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
