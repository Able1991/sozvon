<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Calls.TranscriptRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" CornerRadius="4" Background="Transparent" Tapped="OnTapped">
        <Border x:Name="StarredFill" Background="#1FF5B400" Visibility="Collapsed" />
        <Border x:Name="PlayingFill" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14" Visibility="Collapsed" />
        <Rectangle x:Name="PlayingBar" Width="2" HorizontalAlignment="Left" Visibility="Collapsed"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        <Grid Padding="8,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeText" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="PlayingTimeText" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="12"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="Body" Grid.Column="1" TextWrapping="Wrap" />
            <FontIcon x:Name="StarIcon" Grid.Column="2" Margin="0,4,0,0" VerticalAlignment="Top" FontSize="10" Glyph="&#xE735;"
                      Foreground="#F5B400" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
