<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Calls.CallDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calls="using:Sozvon.App.Calls"
    xmlns:s="using:Sozvon.App.Strings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VoiceMeBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="VoiceThemBrush" Color="#C4501B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VoiceMeBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="VoiceThemBrush" Color="#FF9B6A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="VoiceMeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="VoiceThemBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <DataTemplate x:Key="ParagraphTemplate" x:DataType="calls:SummaryPiece">
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </DataTemplate>
            <DataTemplate x:Key="HeadingTemplate" x:DataType="calls:SummaryPiece">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Text}" TextWrapping="Wrap" />
            </DataTemplate>
            <DataTemplate x:Key="BulletTemplate" x:DataType="calls:SummaryPiece">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="•" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TaskTemplate" x:DataType="calls:SummaryPiece">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="16" Glyph="{x:Bind calls:CallDetailView.TaskGlyph(Done)}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Owner}" Visibility="{x:Bind calls:CallsPage.Shown(Owner)}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="MyLineTemplate" x:DataType="calls:TranscriptLine">
                <Grid Padding="0,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,2,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Time}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{ThemeResource VoiceMeBrush}" Text="{x:Bind SpeakerLabel}" />
                        <Run Text="{x:Bind Text}" />
                    </TextBlock>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TheirLineTemplate" x:DataType="calls:TranscriptLine">
                <Grid Padding="0,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,2,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Time}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{ThemeResource VoiceThemBrush}" Text="{x:Bind SpeakerLabel}" />
                        <Run Text="{x:Bind Text}" />
                    </TextBlock>
                </Grid>
            </DataTemplate>
            <calls:TranscriptLineSelector x:Key="LineSelector" Mine="{StaticResource MyLineTemplate}" Theirs="{StaticResource TheirLineTemplate}" />
            <calls:SummaryPieceSelector x:Key="PieceSelector"
                                        Paragraph="{StaticResource ParagraphTemplate}"
                                        Heading="{StaticResource HeadingTemplate}"
                                        Bullet="{StaticResource BulletTemplate}"
                                        Task="{StaticResource TaskTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid Padding="12,0,24,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <SelectorBar x:Name="Tabs" HorizontalAlignment="Left" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="SummaryTab" Text="{s:L K='Саммари'}" IsSelected="True" />
                <SelectorBarItem x:Name="TranscriptTab" Text="{s:L K='Расшифровка'}" />
            </SelectorBar>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <DropDownButton Content="{s:L K='Поделиться'}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{s:L K='Копировать саммари'}" Click="OnCopySummary" />
                            <MenuFlyoutItem Text="{s:L K='Копировать расшифровку'}" Click="OnCopyTranscript" />
                            <MenuFlyoutItem x:Name="OpenTranscriptItem" Text="{s:L K='Открыть расшифровку'}" Click="OnOpenTranscript" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton Content="{s:L K='Ещё'}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ShowFolderItem" Text="{s:L K='Показать в проводнике'}" Click="OnShowFolder" />
                            <MenuFlyoutItem x:Name="LogItem" Text="{s:L K='Журнал обработки'}" Click="OnOpenLog" />
                            <MenuFlyoutSeparator x:Name="DiskSizeSeparator" />
                            <MenuFlyoutItem x:Name="DiskSizeItem" IsEnabled="False" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="SummaryPane" Grid.Row="1">
            <StackPanel Padding="24,16,24,24" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Meta, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.People, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasPeople, Mode=OneWay}" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsClosable="False" />

                <StackPanel Spacing="16">
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{s:L K='Заметки'}" />
                        <Border Padding="16,12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="calls:NoteRow">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Stamp}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Blocks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="calls:SummaryBlock">
                                <StackPanel Margin="0,0,0,16" Spacing="8">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <Border Padding="16,12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <ItemsControl ItemsSource="{x:Bind Pieces}" ItemTemplateSelector="{StaticResource PieceSelector}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{s:L K='Саммари нет'}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="TranscriptPane" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Padding="24,8" Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="FindBox" Width="280" PlaceholderText="{s:L K='Найти в расшифровке (Ctrl+F)'}" TextChanged="OnFindChanged" />
                <TextBlock x:Name="FindCount" Margin="8,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button ToolTipService.ToolTip="{s:L K='Предыдущее совпадение'}" AutomationProperties.Name="{s:L K='Предыдущее совпадение'}" Click="OnFindPrevious">
                    <FontIcon FontSize="14" Glyph="&#xE70E;" />
                </Button>
                <Button ToolTipService.ToolTip="{s:L K='Следующее совпадение'}" AutomationProperties.Name="{s:L K='Следующее совпадение'}" Click="OnFindNext">
                    <FontIcon FontSize="14" Glyph="&#xE70D;" />
                </Button>
            </StackPanel>
            <ListView x:Name="TranscriptList" Grid.Row="1" Padding="8,0" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}" ItemClick="OnLineClick"
                      ItemTemplateSelector="{StaticResource LineSelector}" />
            <TextBlock x:Name="NoTranscriptText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{s:L K='Нет расшифровки'}" />
        </Grid>

        <Grid x:Name="PlayerBar" Grid.Row="2" Padding="24,0" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="{s:L K='Назад на 15 секунд'}" AutomationProperties.Name="{s:L K='Назад на 15 секунд'}" Command="{x:Bind ViewModel.Player.BackCommand, Mode=OneWay}">
                <FontIcon FontSize="16" Glyph="&#xE892;" />
            </Button>
            <Button x:Name="PlayButton" Grid.Column="1" Width="32" Height="32" Padding="0" Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{s:L K='Воспроизвести'}" AutomationProperties.Name="{s:L K='Воспроизвести'}" Command="{x:Bind ViewModel.Player.TogglePlayCommand, Mode=OneWay}">
                <FontIcon x:Name="PlayIcon" FontSize="16" Glyph="&#xE768;" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="{s:L K='Вперёд на 15 секунд'}" AutomationProperties.Name="{s:L K='Вперёд на 15 секунд'}" Command="{x:Bind ViewModel.Player.ForwardCommand, Mode=OneWay}">
                <FontIcon FontSize="16" Glyph="&#xE893;" />
            </Button>
            <TextBlock x:Name="PositionText" Grid.Column="3" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="PositionSlider" Grid.Column="4" VerticalAlignment="Center" Minimum="0" StepFrequency="1" IsThumbToolTipEnabled="False" ValueChanged="OnSliderChanged" />
            <TextBlock x:Name="UnavailableText" Grid.Column="4" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="DurationText" Grid.Column="5" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="SpeedPanel" Grid.Column="6" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="Speed1" Padding="8,0" Height="32" Content="1x" IsChecked="True" Click="OnSpeedClick" />
                <ToggleButton x:Name="Speed15" Padding="8,0" Height="32" Content="1.5x" Click="OnSpeedClick" />
                <ToggleButton x:Name="Speed2" Padding="8,0" Height="32" Content="2x" Click="OnSpeedClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
