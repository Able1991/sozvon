<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Calls.CallDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calls="using:Sozvon.App.Calls"
    xmlns:s="using:Sozvon.App.Strings"
    xmlns:rec="using:Sozvon.App.Recording">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CoralBrush" Color="#C4501B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CoralBrush" Color="#FF9B6A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CoralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate x:Key="ParagraphTemplate" x:DataType="calls:SummaryPiece">
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </DataTemplate>
            <DataTemplate x:Key="HeadingTemplate" x:DataType="calls:SummaryPiece">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Text}" TextWrapping="Wrap" />
            </DataTemplate>
            <DataTemplate x:Key="BulletTemplate" x:DataType="calls:SummaryPiece">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="•" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TaskTemplate" x:DataType="calls:SummaryPiece">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" Margin="0,2,0,0" FontSize="16" Glyph="{x:Bind calls:CallDetailView.TaskGlyph(Done)}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Owner}" Visibility="{x:Bind calls:CallsPage.Shown(Owner)}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <calls:SummaryPieceSelector x:Key="PieceSelector"
                                        Paragraph="{StaticResource ParagraphTemplate}"
                                        Heading="{StaticResource HeadingTemplate}"
                                        Bullet="{StaticResource BulletTemplate}"
                                        Task="{StaticResource TaskTemplate}" />
            <Style x:Key="BarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="12,0,24,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <SelectorBar x:Name="Tabs" HorizontalAlignment="Left" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="SummaryTab" Text="{s:L K='Саммари'}" IsSelected="True" />
                <SelectorBarItem x:Name="TranscriptTab" Text="{s:L K='Расшифровка'}" />
            </SelectorBar>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <DropDownButton Content="{s:L K='Поделиться'}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{s:L K='Копировать саммари'}" Click="OnCopySummary" />
                            <MenuFlyoutItem Text="{s:L K='Копировать расшифровку'}" Click="OnCopyTranscript" />
                            <MenuFlyoutItem x:Name="OpenTranscriptItem" Text="{s:L K='Открыть расшифровку'}" Click="OnOpenTranscript" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton Content="{s:L K='Ещё'}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="ShowFolderItem" Text="{s:L K='Показать в проводнике'}" Click="OnShowFolder" />
                            <MenuFlyoutItem x:Name="LogItem" Text="{s:L K='Журнал обработки'}" Click="OnOpenLog" />
                            <MenuFlyoutSeparator x:Name="DiskSizeSeparator" />
                            <MenuFlyoutItem x:Name="DiskSizeItem" IsEnabled="False" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Ctrl+F on the Transcript tab: the field, "3 из 12", previous, next and close, one height. -->
        <Grid x:Name="FindBar" Grid.Row="1" Padding="24,6,16,6" ColumnSpacing="4" Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" Height="32" VerticalContentAlignment="Center"
                     PlaceholderText="{s:L K='Найти в расшифровке'}" AutomationProperties.Name="{s:L K='Найти в расшифровке'}"
                     TextChanged="OnFindChanged" PreviewKeyDown="OnFindKeyDown" />
            <TextBlock x:Name="FindCount" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="FindPrevious" Grid.Column="2" Style="{StaticResource BarButtonStyle}" IsEnabled="False"
                    ToolTipService.ToolTip="{s:L K='Предыдущее совпадение'}" AutomationProperties.Name="{s:L K='Предыдущее совпадение'}" Click="OnFindPrevious">
                <FontIcon FontSize="14" Glyph="&#xE70E;" />
            </Button>
            <Button x:Name="FindNext" Grid.Column="3" Style="{StaticResource BarButtonStyle}" IsEnabled="False"
                    ToolTipService.ToolTip="{s:L K='Следующее совпадение'}" AutomationProperties.Name="{s:L K='Следующее совпадение'}" Click="OnFindNext">
                <FontIcon FontSize="14" Glyph="&#xE70D;" />
            </Button>
            <Button x:Name="FindClose" Grid.Column="4" Style="{StaticResource BarButtonStyle}"
                    ToolTipService.ToolTip="{s:L K='Закрыть поиск'}" AutomationProperties.Name="{s:L K='Закрыть поиск'}" Click="OnFindClose">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="2">
            <StackPanel x:Name="Page" MaxWidth="800" Padding="24,16,24,96" HorizontalAlignment="Left" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Meta, Mode=OneWay}" />
                    <Grid x:Name="ParticipantsLine" Margin="0,2,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Margin="0,3,0,0" VerticalAlignment="Top" FontSize="14" Glyph="&#xE716;"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{s:L K='Участники'}" />
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Participants, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <rec:FlowPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="calls:ParticipantChip">
                                    <StackPanel Margin="0,0,4,0" Orientation="Horizontal" Spacing="4" Background="Transparent"
                                                ToolTipService.ToolTip="{x:Bind Hint}" AutomationProperties.Name="{x:Bind Name}"
                                                AutomationProperties.HelpText="{x:Bind Hint}">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Name}"
                                                   Visibility="{x:Bind calls:CallsPage.ShownIf(Unconfirmed, x:False)}" />
                                        <TextBlock Foreground="{ThemeResource CoralBrush}" Text="{x:Bind Name}"
                                                   Visibility="{x:Bind calls:CallsPage.ShownIf(Unconfirmed, x:True)}" />
                                        <FontIcon Margin="0,1,0,0" FontSize="13" Glyph="&#xEC61;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  Visibility="{x:Bind calls:CallsPage.ShownIf(Saved, x:True)}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsClosable="False" />

                <!-- Notes come first: what the user wrote down matters more than what the model made of the call. -->
                <StackPanel x:Name="NotesSection" Spacing="8">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{s:L K='Заметки'}" />
                        <HyperlinkButton x:Name="AddNoteButton" HorizontalAlignment="Right" Padding="6,2" Click="OnAddNote"
                                         ToolTipService.ToolTip="{s:L K='Добавить заметку'}" AutomationProperties.Name="{s:L K='Добавить заметку'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="{s:L K='Добавить'}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>
                    <StackPanel Padding="16,12" Spacing="10" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ItemsControl x:Name="NotesList" ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="calls:NoteRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Margin="0,8,0,0" VerticalAlignment="Top" Fill="#F5B400" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Stamp}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="28" Height="24" Padding="0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="{s:L K='Действия с заметкой'}" AutomationProperties.Name="{s:L K='Действия с заметкой'}">
                                            <FontIcon FontSize="12" Glyph="&#xE712;" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="{s:L K='Копировать'}" Tag="{x:Bind}" Click="OnCopyNote" />
                                                    <MenuFlyoutItem Text="{s:L K='Удалить заметку'}" Tag="{x:Bind}" Click="OnDeleteNote" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoNotesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{s:L K='Заметок пока нет: решения, договорённости, что проверить потом.'}" />
                        <TextBox x:Name="NoteBox" Visibility="Collapsed" AcceptsReturn="False" TextWrapping="Wrap" MaxLength="4000"
                                 PlaceholderText="{s:L K='Заметка'}" AutomationProperties.Name="{s:L K='Заметка'}" PreviewKeyDown="OnNoteKeyDown" />
                        <TextBlock x:Name="NoteError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <Grid x:Name="NoteDeleted" Visibility="Collapsed" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{s:L K='Заметка удалена'}" />
                            <HyperlinkButton x:Name="UndoDeleteButton" HorizontalAlignment="Right" Padding="6,2" Content="{s:L K='Вернуть'}" Click="OnUndoDeleteNote" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SummaryContent" Spacing="16">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Blocks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="calls:SummaryBlock">
                                <StackPanel Margin="0,0,0,16" Spacing="8">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <Border Padding="16,12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <ItemsControl ItemsSource="{x:Bind Pieces}" ItemTemplateSelector="{StaticResource PieceSelector}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{s:L K='Саммари нет'}" />
                </StackPanel>

                <StackPanel x:Name="TranscriptContent" Visibility="Collapsed">
                    <ItemsRepeater x:Name="TranscriptRepeater" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="calls:TranscriptRow">
                                <calls:TranscriptRowView Row="{x:Bind}" Activated="OnRowActivated" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock x:Name="NoTranscriptText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{s:L K='Нет расшифровки'}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The player floats over the bottom of the page, as on the Mac; the page keeps room for it below. -->
        <Grid x:Name="PlayerBar" Grid.Row="2" Height="56" Margin="16,0,16,16" Padding="12,0,10,0" VerticalAlignment="Bottom" ColumnSpacing="6"
              CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource BarButtonStyle}"
                    ToolTipService.ToolTip="{s:L K='Назад на 15 секунд'}" AutomationProperties.Name="{s:L K='Назад на 15 секунд'}" Command="{x:Bind ViewModel.Player.BackCommand, Mode=OneWay}">
                <Grid>
                    <FontIcon FontSize="20" Glyph="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="SemiBold" Text="15" />
                </Grid>
            </Button>
            <Button x:Name="PlayButton" Grid.Column="1" Width="36" Height="36" Padding="0" CornerRadius="18" Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{s:L K='Воспроизвести'}" AutomationProperties.Name="{s:L K='Воспроизвести'}" Command="{x:Bind ViewModel.Player.TogglePlayCommand, Mode=OneWay}">
                <FontIcon x:Name="PlayIcon" FontSize="14" Glyph="&#xF5B0;" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="2" Style="{StaticResource BarButtonStyle}"
                    ToolTipService.ToolTip="{s:L K='Вперёд на 15 секунд'}" AutomationProperties.Name="{s:L K='Вперёд на 15 секунд'}" Command="{x:Bind ViewModel.Player.ForwardCommand, Mode=OneWay}">
                <Grid>
                    <FontIcon FontSize="20" Glyph="&#xE72C;" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="SemiBold" Text="15" />
                </Grid>
            </Button>
            <TextBlock x:Name="PositionText" Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Slider x:Name="PositionSlider" Grid.Column="4" Margin="6,0" VerticalAlignment="Center" Minimum="0" StepFrequency="1" IsThumbToolTipEnabled="False"
                    AutomationProperties.Name="{s:L K='Позиция'}" ValueChanged="OnSliderChanged" />
            <TextBlock x:Name="UnavailableText" Grid.Column="4" Margin="6,0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="DurationText" Grid.Column="5" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <DropDownButton x:Name="SpeedButton" Grid.Column="6" Height="32" MinWidth="64" Margin="6,0,0,0" Content="1x"
                            ToolTipService.ToolTip="{s:L K='Скорость'}" AutomationProperties.Name="{s:L K='Скорость'}">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <RadioMenuFlyoutItem x:Name="Speed1" Text="1x" GroupName="Speed" IsChecked="True" Click="OnSpeedClick" />
                        <RadioMenuFlyoutItem x:Name="Speed15" Text="1.5x" GroupName="Speed" Click="OnSpeedClick" />
                        <RadioMenuFlyoutItem x:Name="Speed2" Text="2x" GroupName="Speed" Click="OnSpeedClick" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
    </Grid>
</UserControl>
