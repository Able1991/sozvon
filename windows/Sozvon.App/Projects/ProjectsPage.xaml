<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Projects.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calls="using:Sozvon.App.Calls"
    xmlns:projects="using:Sozvon.App.Projects"
    xmlns:s="using:Sozvon.App.Strings">

    <Grid Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid MaxWidth="1000" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{s:L K='Проекты'}" />
                <TextBlock x:Name="Summary" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="NewButton" Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="OnNew"
                    AutomationProperties.Name="{s:L K='Новый проект'}" ToolTipService.ToolTip="{s:L K='Новый проект'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{s:L K='Новый проект'}" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="ProjectList" Grid.Row="1" MaxWidth="1000" Margin="-12,0" Padding="0,0,0,24" SelectionMode="Single"
                  AutomationProperties.Name="{s:L K='Проекты'}" ItemsSource="{x:Bind Rows}"
                  DoubleTapped="OnListDoubleTapped" ContainerContentChanging="OnContainerContentChanging">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="projects:ProjectRow">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind calls:CallsPage.ProjectBrush(Slug)}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind Details}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="1" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon HorizontalAlignment="Center" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B7;" />
            <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{s:L K='Проектов пока нет'}" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{s:L K='Проект это команда и её слова: имена, продукты, термины. С ними расшифровка точнее, а саммари знает, о ком речь.'}" />
            <Button HorizontalAlignment="Center" Content="{s:L K='Новый проект…'}" Click="OnNew" />
        </StackPanel>
    </Grid>
</UserControl>
