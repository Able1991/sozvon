<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Settings.AssistantInstallHelp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander x:Name="Box" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              AutomationProperties.AutomationId="AssistantInstallHelp">
        <Expander.Header>
            <TextBlock x:Name="HeaderText" />
        </Expander.Header>
        <StackPanel Spacing="12">
            <TextBlock x:Name="Explanation" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="Rows" Spacing="8" />
            <Button x:Name="RecheckButton" Click="OnRecheck" AutomationProperties.AutomationId="AssistantRecheck" />
        </StackPanel>
    </Expander>
</UserControl>
