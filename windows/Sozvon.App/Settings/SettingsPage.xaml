<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sozvon.App.Settings"
    xmlns:s="using:Sozvon.App.Strings">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,28,0,4" />
        </Style>
        <!-- The switch alone, so it ends on the same right edge as the boxes and buttons in other rows;
             the template keeps a fixed 12 DIP column for the text even when there is none. -->
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,-12,0" />
        </Style>
        <Style x:Key="Foot" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="36,24,20,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{s:L K='Настройки'}" />

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}" Severity="Error" IsClosable="False"
                 Title="{s:L K='Настройки не сохранились'}" Message="{x:Bind ViewModel.SaveError, Mode=OneWay}" />

        <SelectorBar x:Name="Tabs" Grid.Row="2" Margin="-12,0,0,0" SelectionChanged="OnTabChanged" PreviewKeyDown="OnTabsKey" HorizontalAlignment="Left">
            <SelectorBarItem Text="{s:L K='Основные'}" IsSelected="True" Tag="General" />
            <SelectorBarItem Text="{s:L K='Распознавание'}" Tag="Recognition" />
            <SelectorBarItem Text="{s:L K='Ассистенты'}" Tag="Assistants" />
            <SelectorBarItem Text="{s:L K='Облако'}" Tag="Cloud" />
            <SelectorBarItem Text="{s:L K='О программе'}" Tag="About" />
        </SelectorBar>

        <!-- A tab stop of its own, as scrollable regions should be; a tab chosen with the mouse puts the focus here, quietly. -->
        <ScrollViewer x:Name="Pane" Grid.Row="3" ViewChanged="OnPaneScrolled" IsTabStop="True" AutomationProperties.Name="{s:L K='Настройки'}">
            <Grid MaxWidth="1000" Padding="0,0,16,24">
                <StackPanel x:Name="General" Spacing="4">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Профиль'}" />
                    <local:SettingsRow Header="{s:L K='Как тебя подписывать'}" Description="{s:L K='Имя пишется в расшифровке рядом с твоими репликами'}">
                        <TextBox Width="260" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Тема'}">
                        <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{s:L K='Светлая'}" />
                            <ComboBoxItem Content="{s:L K='Тёмная'}" />
                            <ComboBoxItem Content="{s:L K='Как в системе'}" />
                        </ComboBox>
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Язык интерфейса'}">
                        <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{s:L K='Как в системе'}" />
                            <ComboBoxItem Content="Русский" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </local:SettingsRow>
                    <InfoBar IsOpen="{x:Bind ViewModel.NeedsRelaunch, Mode=OneWay}" IsClosable="False" Severity="Informational"
                             Title="{s:L K='Язык изменится после перезапуска'}" Message="{s:L K='Открытые окна закроются, запись не прервётся.'}">
                        <InfoBar.ActionButton>
                            <Button Content="{s:L K='Перезапустить Sozvon'}" Command="{x:Bind ViewModel.RelaunchCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Запуск'}" />
                    <local:SettingsRow Header="{s:L K='Открывать при входе'}" Description="{x:Bind ViewModel.SignIn.Description, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.SignIn.IsOn, Mode=TwoWay}" AutomationProperties.Name="{s:L K='Открывать при входе'}" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Запись'}" />
                    <local:SettingsRow Header="{s:L K='Плавающая панель'}" Description="{s:L K='Капсула поверх всех окон'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.FloatingPanel, Mode=TwoWay}" AutomationProperties.Name="{s:L K='Плавающая панель'}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Показывать панель и без записи'}" Description="{s:L K='Капсула видна, даже когда запись не идёт'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.CapsuleWhenIdle, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.FloatingPanel, Mode=OneWay}"
                                      AutomationProperties.Name="{s:L K='Показывать панель и без записи'}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Когда начинается звонок'}" Description="{x:Bind ViewModel.CallStartDescription, Mode=OneWay}">
                        <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.Settings.CallStartAction, Mode=TwoWay}">
                            <ComboBoxItem Content="{s:L K='Спрашивать'}" />
                            <ComboBoxItem Content="{s:L K='Записывать сам'}" />
                            <ComboBoxItem Content="{s:L K='Ничего не делать'}" />
                        </ComboBox>
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Останавливать после звонка'}" Description="{x:Bind ViewModel.StopAfterCallDescription}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.StopAfterCall, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Напоминать сказать о записи'}" Description="{s:L K='На несколько секунд в начале записи'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.RemindToSay, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Предупреждать о тишине'}" Description="{s:L K='Если тебя или собеседников не слышно больше двух минут или тебя очень тихо слышно'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.WarnOnSilence, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Звук при старте и остановке записи'}" Description="{s:L K='Во время звонка звука нет: его услышали бы собеседники'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.PlaySounds, Mode=TwoWay}" AutomationProperties.Name="{s:L K='Звук при старте и остановке записи'}" />
                    </local:SettingsRow>
                    <InfoBar IsOpen="{x:Bind ViewModel.MarkShortcutTaken, Mode=OneWay}" Severity="Warning" IsClosable="False"
                             Message="{x:Bind ViewModel.MarkShortcutWarning}" />
                    <TextBlock Style="{StaticResource Foot}" Text="{x:Bind ViewModel.RecordingFooter, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Записи с телефона'}" />
                    <local:SettingsRow Header="{s:L K='Папка для записей'}" Description="{x:Bind ViewModel.PhoneFolderText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{s:L K='Убрать'}" Visibility="{x:Bind ViewModel.HasPhoneFolder, Mode=OneWay}" Click="OnClearPhoneFolder" />
                            <Button Content="{s:L K='Выбрать папку…'}" Click="OnChoosePhoneFolder" />
                        </StackPanel>
                    </local:SettingsRow>
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Новая запись в этой папке расшифруется сама, а файл перейдёт в подпапку Imported. Подойдёт папка, куда телефон сохраняет записи: iCloud Drive, OneDrive или Google Drive.'}" />
                    <HyperlinkButton Margin="-12,0,0,0" Padding="12,2" Content="{s:L K='Запись одним нажатием на iPhone'}" NavigateUri="{x:Bind ViewModel.PhoneShortcutDocs}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Разрешения'}" />
                    <local:SettingsRow Header="{s:L K='Микрофон'}">
                        <Button Content="{s:L K='Открыть параметры конфиденциальности'}" Click="OnOpenMicrophoneSettings" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Голоса'}" />
                    <local:SettingsRow x:Name="MyVoiceRow" Header="{s:L K='Твой голос'}" />
                    <local:SettingsRow x:Name="OtherVoicesRow" Header="{s:L K='Голоса собеседников'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="OtherVoicesCount" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="ManageVoicesButton" Content="{s:L K='Управлять…'}" Click="OnManageVoices" />
                        </StackPanel>
                    </local:SettingsRow>
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Отпечатки голосов относятся к биометрическим данным: они хранятся на этом компьютере. Sozvon использует их только для того, чтобы называть собеседников в твоих звонках.'}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='После звонка'}" />
                    <local:SettingsRow Header="{s:L K='Сразу расшифровывать, если всё понятно'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.TranscribeWhenClear, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Автоудаление аудио'}">
                        <ComboBox x:Name="AudioRetentionBox" Width="200" SelectedIndex="{x:Bind ViewModel.Settings.AudioRetention, Mode=TwoWay}"
                                  AutomationProperties.Name="{s:L K='Автоудаление аудио'}">
                            <ComboBoxItem Content="{s:L K='Никогда'}" />
                            <ComboBoxItem Content="{s:L K='Через неделю'}" />
                            <ComboBoxItem Content="{s:L K='Через 15 дней'}" />
                            <ComboBoxItem Content="{s:L K='Через 30 дней'}" />
                            <ComboBoxItem Content="{s:L K='Через 60 дней'}" />
                        </ComboBox>
                    </local:SettingsRow>
                </StackPanel>

                <StackPanel x:Name="Recognition" Spacing="4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Модель'}" />
                    <local:SettingsRow Header="{s:L K='Модель распознавания'}">
                        <ComboBox x:Name="ModelBox" Width="240" SelectedIndex="{x:Bind ViewModel.SpeechModelIndex, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Языки звонков'}">
                        <local:LanguagesButton x:Name="CallLanguagesBox" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Переключение языка посреди речи'}" Description="{s:L K='Язык определяется для каждой фразы, медленнее на 20-30%'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.LanguageSwitching, Mode=TwoWay}" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Движок'}" />
                    <local:SettingsRow Header="Python">
                        <TextBlock x:Name="PythonStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='MCP-сервер'}" Description="{x:Bind ViewModel.Integrations.ServerFailure, Mode=OneWay}">
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.Integrations.ServerStatus, Mode=OneWay}" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Файлы'}" />
                    <local:SettingsRow Header="{s:L K='Папка записей'}" Description="{x:Bind ViewModel.CallsFolder}">
                        <Button Content="{s:L K='Показать в проводнике'}" Click="OnShowCallsFolder" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Папка данных'}" Description="{x:Bind ViewModel.DataFolder}">
                        <Button Content="{s:L K='Показать в проводнике'}" Click="OnShowDataFolder" />
                    </local:SettingsRow>
                </StackPanel>

                <StackPanel x:Name="Assistants" Spacing="4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Саммари'}" />
                    <local:SettingsRow Header="{s:L K='Помощник для саммари'}">
                        <ComboBox x:Name="AssistantBox" Width="240" SelectedIndex="{x:Bind ViewModel.SummaryAssistantIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{s:L K='Помощник для саммари'}" />
                    </local:SettingsRow>
                    <TextBlock Style="{StaticResource Foot}" Text="{x:Bind ViewModel.SummaryFooter, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasSummaryWarning, Mode=OneWay}" Severity="Warning" IsClosable="False"
                             Message="{x:Bind ViewModel.SummaryWarning, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Подключения'}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Integrations.Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AssistantRow">
                                <local:SettingsRow Header="{x:Bind Title}" Description="{s:L K='Видит звонки, саммари и заметки'}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Checking, Mode=OneWay}" Visibility="{x:Bind Checking, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind StatusVisible, Mode=OneWay}">
                                            <FontIcon FontSize="14" Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                                            <FontIcon FontSize="14" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind Outdated, Mode=OneWay}"
                                                      ToolTipService.ToolTip="{s:L K='Sozvon подключён по-старому: без общего сервера или пароля. Подключи заново.'}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Content="{x:Bind ActionText, Mode=OneWay}" Visibility="{x:Bind ActionVisible, Mode=OneWay}"
                                                IsEnabled="{x:Bind Enabled, Mode=OneWay}" Tag="{x:Bind}" Click="OnAssistantAction" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <InfoBar IsOpen="{x:Bind ViewModel.Integrations.HasMessage, Mode=OneWay}" Severity="Warning" IsClosable="False"
                             Message="{x:Bind ViewModel.Integrations.Message, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Подключить вручную'}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Integrations.Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AssistantRow">
                                <local:SettingsRow Header="{x:Bind Title}" Description="{x:Bind ShortCommand}">
                                    <Button Content="{x:Bind CopyText, Mode=OneWay}" Tag="{x:Bind}" Click="OnCopyAssistantCommand"
                                            ToolTipService.ToolTip="{s:L K='То же, что делает «Подключить», с паролем'}" />
                                </local:SettingsRow>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Ассистент сможет искать по звонкам, читать саммари и расшифровки: «что решили с клиентом на прошлой неделе?». Один общий сервер на все сессии, работает, пока запущен Sozvon. Данные читаются с этого компьютера.'}" />
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Codex и Cursor на Windows ещё не проверены с настоящими программами: подключаются только по кнопке.'}" />
                </StackPanel>

                <StackPanel x:Name="Cloud" Spacing="4" Visibility="Collapsed">
                    <InfoBar IsOpen="{x:Bind ViewModel.Server.HasSaveError, Mode=OneWay}" Severity="Error" IsClosable="False"
                             Title="{s:L K='Настройки не сохранились'}" Message="{x:Bind ViewModel.Server.SaveError, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Свой сервер, свои данные'}" />
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Копии готовых звонков уходят на сервер в твоём аккаунте Cloudflare: так Claude и ChatGPT видят их и с телефона. У нас ничего не хранится.'}" />
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Поставить сервер в один клик пока можно только с Mac. Здесь укажи адрес и пароль сервера, который уже есть.'}" />

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Server.HasConnector, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Claude и ChatGPT'}" />
                        <local:SettingsRow Header="{s:L K='Адрес коннектора'}" Description="{x:Bind ViewModel.Server.ConnectorUrl, Mode=OneWay}">
                            <Button Content="{s:L K='Скопировать'}" Click="OnCopyConnector" AutomationProperties.Name="{s:L K='Скопировать адрес для коннектора'}" />
                        </local:SettingsRow>
                        <local:SettingsRow Header="{s:L K='Пароль'}" Description="{x:Bind ViewModel.Server.PasswordShown, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton IsChecked="{x:Bind ViewModel.Server.ShowPassword, Mode=TwoWay}" AutomationProperties.Name="{s:L K='Показать пароль'}">
                                    <FontIcon FontSize="14" Glyph="&#xE7B3;" />
                                </ToggleButton>
                                <Button Content="{s:L K='Скопировать'}" Click="OnCopyServerPassword" AutomationProperties.Name="{s:L K='Скопировать пароль'}" />
                            </StackPanel>
                        </local:SettingsRow>
                        <local:SettingsRow Header="{s:L K='Подключить в приложении'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{s:L K='Открыть Claude'}" Click="OnOpenClaudeConnectors" />
                                <Button Content="{s:L K='Открыть ChatGPT'}" Click="OnOpenChatGptConnectors" />
                            </StackPanel>
                        </local:SettingsRow>
                        <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Добавь адрес как коннектор и войди тем же паролем'}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Свой адрес'}" />
                    <local:SettingsRow Header="{s:L K='Адрес сервера'}">
                        <TextBox Width="320" PlaceholderText="https://sozvon.example.com" Text="{x:Bind ViewModel.Server.UrlDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnServerFieldKeyDown" AutomationProperties.Name="{s:L K='Адрес сервера'}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Пароль'}">
                        <PasswordBox Width="320" Password="{x:Bind ViewModel.Server.PasswordDraft, Mode=TwoWay}" KeyDown="OnServerFieldKeyDown"
                                     AutomationProperties.Name="{s:L K='Пароль'}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Синхронизация'}" Description="{x:Bind ViewModel.Server.StatusWhenFine, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.Server.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.Server.IsRunning, Mode=OneWay}" />
                            <Button Content="{s:L K='Синхронизировать'}" Visibility="{x:Bind ViewModel.Server.HasServer, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.Server.CanSync, Mode=OneWay}" Click="OnSyncServer" />
                            <Button Content="{s:L K='Сохранить'}" IsEnabled="{x:Bind ViewModel.Server.CanSave, Mode=OneWay}" Click="OnSaveServer" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </local:SettingsRow>
                    <InfoBar IsOpen="{x:Bind ViewModel.Server.Failed, Mode=OneWay}" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.Server.Status, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Сервер в твоём аккаунте Cloudflare: звонки не попадают к нам, удалить всё можно в любой момент. Текст звонков уходит всегда, звук и отпечатки голосов, только если включено ниже. Согласие собеседников на запись на тебе.'}" />
                    <HyperlinkButton Margin="-12,0,0,0" Padding="12,2" Content="{s:L K='Как это устроено'}" NavigateUri="{x:Bind ViewModel.Server.DocsUrl}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Что отправляется'}" />
                    <local:SettingsRow Header="{s:L K='Расшифровки, саммари и заметки'}">
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{s:L K='Всегда'}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Аудио звонков'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Server.SyncAudio, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Server.HasServer, Mode=OneWay}"
                                      AutomationProperties.Name="{s:L K='Аудио звонков'}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Отпечатки голосов'}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Server.SyncVoices, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Server.HasServer, Mode=OneWay}"
                                      AutomationProperties.Name="{s:L K='Отпечатки голосов'}" />
                    </local:SettingsRow>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Server.HasServer, Mode=OneWay}">
                        <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Звук звонков с голосами собеседников будет храниться в твоём аккаунте Cloudflare: за него и за согласие тех, кого ты записываешь, отвечаешь ты. Бесплатного хранилища хватит примерно на 80 часов звонков, дальше уходит только текст. Если выключить, новые записи перестанут отправляться.'}" />
                        <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Отпечатки голосов относятся к биометрическим данным. Когда включено, они хранятся в твоём аккаунте Cloudflare, и отвечаешь за них ты. Если выключить, они останутся только на этом компьютере, а уже отправленные пробудут на сервере, пока их не удалить.'}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Foot}" Visibility="{x:Bind ViewModel.Server.NotReady, Mode=OneWay}" Text="{s:L K='Станет доступно после подключения сервера.'}" />
                </StackPanel>
                <StackPanel x:Name="About" Spacing="4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sozvon" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Version}" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Ссылки'}" />
                    <local:SettingsRow Header="{s:L K='Сайт'}">
                        <HyperlinkButton Content="able1991.github.io/sozvon" NavigateUri="https://able1991.github.io/sozvon/" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Исходный код'}">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/Able1991/sozvon" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Лицензия'}">
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="MIT" />
                    </local:SettingsRow>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <!-- The tabs stay put while the pane scrolls under them: a hairline marks the edge once anything is hidden there. -->
        <Border x:Name="PaneDivider" Grid.Row="3" Height="1" Margin="-36,0,-20,0" VerticalAlignment="Top" Visibility="Collapsed"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Grid>
</UserControl>
