<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sozvon.App.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sozvon.App.Settings"
    xmlns:s="using:Sozvon.App.Strings">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Foot" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="24,16,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}" Severity="Error" IsClosable="False"
                 Title="{s:L K='Настройки не сохранились'}" Message="{x:Bind ViewModel.SaveError, Mode=OneWay}" />

        <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" MaxWidth="1000" HorizontalAlignment="Stretch">
            <SelectorBarItem Text="{s:L K='Основные'}" IsSelected="True" Tag="General" />
            <SelectorBarItem Text="{s:L K='Распознавание'}" Tag="Recognition" />
            <SelectorBarItem Text="{s:L K='Ассистенты'}" Tag="Assistants" />
            <SelectorBarItem Text="{s:L K='Облако'}" Tag="Cloud" />
            <SelectorBarItem Text="{s:L K='О программе'}" Tag="About" />
        </SelectorBar>

        <ScrollViewer Grid.Row="1">
            <Grid MaxWidth="1000" Padding="0,0,16,16">
                <StackPanel x:Name="General" Spacing="4">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Профиль'}" />
                    <local:SettingsRow Header="{s:L K='Как тебя подписывать'}" Description="{s:L K='Имя пишется в расшифровке рядом с твоими репликами'}" NotConnected="True">
                        <TextBox Width="260" Text="{x:Bind ViewModel.Settings.DisplayName, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Тема'}">
                        <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <RadioButton Content="{s:L K='Светлая'}" />
                            <RadioButton Content="{s:L K='Тёмная'}" />
                            <RadioButton Content="{s:L K='Как в системе'}" />
                        </RadioButtons>
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Язык интерфейса'}">
                        <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <RadioButton Content="{s:L K='Как в системе'}" />
                            <RadioButton Content="Русский" />
                            <RadioButton Content="English" />
                        </RadioButtons>
                    </local:SettingsRow>
                    <InfoBar IsOpen="{x:Bind ViewModel.NeedsRelaunch, Mode=OneWay}" IsClosable="False" Severity="Informational"
                             Title="{s:L K='Язык изменится после перезапуска'}" Message="{s:L K='Открытые окна закроются, запись не прервётся.'}">
                        <InfoBar.ActionButton>
                            <Button Content="{s:L K='Перезапустить Sozvon'}" Command="{x:Bind ViewModel.RelaunchCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Запись'}" />
                    <local:SettingsRow Header="{s:L K='Плавающая панель'}" Description="{s:L K='Капсула поверх всех окон'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.FloatingPanel, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Показывать панель и без записи'}" Description="{s:L K='Капсула видна, даже когда запись не идёт'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.PanelWhenIdle, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Когда начинается звонок'}" Description="Zoom, Google Meet, Telegram" NotConnected="True">
                        <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.Settings.CallStartAction, Mode=TwoWay}">
                            <RadioButton Content="{s:L K='Спрашивать'}" />
                            <RadioButton Content="{s:L K='Записывать сам'}" />
                            <RadioButton Content="{s:L K='Ничего не делать'}" />
                        </RadioButtons>
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Останавливать после звонка'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.StopAfterCall, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Напоминать сказать о записи'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.RemindToSay, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Предупреждать о тишине'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.WarnOnSilence, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Звук при старте и остановке записи'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.PlaySounds, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Запись начинается только по кнопке «Записать». Согласие собеседников на запись на тебе.'}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Записи с телефона'}" />
                    <local:SettingsRow Header="{s:L K='Папка для записей'}" NotConnected="True">
                        <Button Content="{s:L K='Выбрать папку…'}" IsEnabled="False" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Разрешения'}" />
                    <local:SettingsRow Header="{s:L K='Микрофон'}">
                        <Button Content="{s:L K='Открыть параметры конфиденциальности'}" Click="OnOpenMicrophoneSettings" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Голоса'}" />
                    <local:SettingsRow Header="{s:L K='Твой голос'}" Description="{s:L K='Образец остаётся на этом компьютере'}" NotConnected="True">
                        <Button Content="{s:L K='Записать…'}" IsEnabled="False" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='После звонка'}" />
                    <local:SettingsRow Header="{s:L K='Открывать при входе'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.OpenAtSignIn, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Сразу расшифровывать, если всё понятно'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.TranscribeWhenClear, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Автоудаление аудио'}" NotConnected="True">
                        <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.Settings.AudioRetention, Mode=TwoWay}">
                            <ComboBoxItem Content="{s:L K='Никогда'}" />
                            <ComboBoxItem Content="{s:L K='Через неделю'}" />
                            <ComboBoxItem Content="{s:L K='Через 15 дней'}" />
                            <ComboBoxItem Content="{s:L K='Через 30 дней'}" />
                            <ComboBoxItem Content="{s:L K='Через 60 дней'}" />
                        </ComboBox>
                    </local:SettingsRow>
                </StackPanel>

                <StackPanel x:Name="Recognition" Spacing="4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Модель'}" />
                    <local:SettingsRow Header="{s:L K='Модель распознавания'}" NotConnected="True">
                        <ComboBox Width="240" SelectedIndex="{x:Bind ViewModel.Settings.SpeechModel, Mode=TwoWay}">
                            <ComboBoxItem Content="Whisper Turbo" />
                            <ComboBoxItem Content="Whisper Large" />
                            <ComboBoxItem Content="Whisper Small" />
                        </ComboBox>
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Языки звонков'}" NotConnected="True">
                        <ComboBox Width="240" SelectedIndex="{x:Bind ViewModel.Settings.CallLanguages, Mode=TwoWay}">
                            <ComboBoxItem Content="{s:L K='Русский + English'}" />
                            <ComboBoxItem Content="{s:L K='Русский'}" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Переключение языка посреди речи'}" Description="{s:L K='Язык определяется для каждой фразы, медленнее на 20-30%'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.LanguageSwitching, Mode=TwoWay}" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Производительность'}" />
                    <local:SettingsRow Header="{s:L K='Низкий приоритет'}" Description="{s:L K='Вентиляторы тише, расшифровка дольше'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.LowPriority, Mode=TwoWay}" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Движок'}" />
                    <local:SettingsRow Header="Python">
                        <TextBlock x:Name="PythonStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Файлы'}" />
                    <local:SettingsRow Header="{s:L K='Папка записей'}" Description="{x:Bind ViewModel.CallsFolder}">
                        <Button Content="{s:L K='Показать в проводнике'}" Click="OnShowCallsFolder" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Папка данных'}" Description="{x:Bind ViewModel.DataFolder}">
                        <Button Content="{s:L K='Показать в проводнике'}" Click="OnShowDataFolder" />
                    </local:SettingsRow>
                </StackPanel>

                <StackPanel x:Name="Assistants" Spacing="4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Саммари'}" />
                    <local:SettingsRow Header="{s:L K='Помощник для саммари'}" NotConnected="True">
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.Settings.SummaryAssistant, Mode=TwoWay}">
                            <RadioButton Content="Claude Code" />
                            <RadioButton Content="Codex" IsEnabled="False" />
                            <RadioButton Content="Cursor" IsEnabled="False" />
                            <RadioButton Content="{s:L K='Без саммари'}" />
                        </RadioButtons>
                    </local:SettingsRow>
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Саммари и поиск проектов, в том числе вопросы открытым сессиям. Текст уходит в Anthropic.'}" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Подключения'}" />
                    <local:SettingsRow Header="Claude Code" Description="{s:L K='Видит звонки, саммари и заметки'}" NotConnected="True">
                        <Button Content="{s:L K='Подключить'}" IsEnabled="False" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="Codex" Description="{s:L K='Пока недоступно на Windows'}">
                        <Button Content="{s:L K='Подключить'}" IsEnabled="False" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="Cursor" Description="{s:L K='Пока недоступно на Windows'}">
                        <Button Content="{s:L K='Подключить'}" IsEnabled="False" />
                    </local:SettingsRow>
                </StackPanel>

                <StackPanel x:Name="Cloud" Spacing="4" Visibility="Collapsed">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{s:L K='Облако на Windows пока не подключено'}" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Свой сервер, свои данные'}" />
                    <TextBlock Style="{StaticResource Foot}" Text="{s:L K='Копии готовых звонков уходят на сервер в твоём аккаунте Cloudflare: так Claude и ChatGPT видят их и с телефона. У нас ничего не хранится.'}" />
                    <local:SettingsRow Header="{s:L K='Подключить Cloudflare'}" NotConnected="True">
                        <Button Content="{s:L K='Подключить Cloudflare'}" IsEnabled="False" />
                    </local:SettingsRow>
                </StackPanel>

                <StackPanel x:Name="About" Spacing="4" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sozvon" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Version}" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Обновления'}" />
                    <local:SettingsRow Header="{s:L K='Обновлять автоматически'}" NotConnected="True">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AutoUpdate, Mode=TwoWay}" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Проверить обновления'}" NotConnected="True">
                        <Button Content="{s:L K='Проверить'}" IsEnabled="False" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Поддержка'}" />
                    <local:SettingsRow Header="{s:L K='Если что-то не работает'}" NotConnected="True">
                        <Button Content="{s:L K='Диагностика…'}" IsEnabled="False" />
                    </local:SettingsRow>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="{s:L K='Ссылки'}" />
                    <local:SettingsRow Header="{s:L K='Сайт'}">
                        <HyperlinkButton Content="able1991.github.io/sozvon" NavigateUri="https://able1991.github.io/sozvon/" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Исходный код'}">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/Able1991/sozvon" />
                    </local:SettingsRow>
                    <local:SettingsRow Header="{s:L K='Лицензия'}">
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="MIT" />
                    </local:SettingsRow>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
