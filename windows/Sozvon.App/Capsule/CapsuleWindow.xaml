<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sozvon.App.Capsule.CapsuleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sozvon">
    <!-- The window itself is transparent: the shape, its rounding and its border are drawn here, so edges stay smooth. -->
    <Grid x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          PointerPressed="OnPressed" PointerMoved="OnMoved" PointerReleased="OnReleased"
          PointerEntered="OnEntered" PointerExited="OnExited">
        <Grid.OpacityTransition>
            <ScalarTransition Duration="0:0:0.167" />
        </Grid.OpacityTransition>
        <Grid.Resources>
            <!-- Buttons inside the capsule have no frame of their own: only a soft fill under the pointer. -->
            <ResourceDictionary>
                <!-- One saturated red for the record dot in both themes: the theme's critical red is pale in the dark. -->
                <SolidColorBrush x:Key="RecordRedBrush" Color="#E5252A" />
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorPrimaryBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="ButtonBackground" ResourceKey="SystemColorButtonFaceColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="HideItem" Click="OnHide" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Every element sits in a slot of the same height on one centre line; sizes are multiples of 4 DIP,
             so at 100, 125 and 150 % they land on whole pixels. -->
        <StackPanel x:Name="Bar" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid x:Name="RecordDot" Width="32" Height="32" Visibility="Collapsed">
                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource RecordRedBrush}" />
            </Grid>
            <Grid x:Name="Spinner" Width="32" Height="32" Visibility="Collapsed">
                <ProgressRing x:Name="SpinnerRing" Width="16" Height="16" IsActive="False" />
            </Grid>
            <Grid x:Name="Check" Width="32" Height="32" Visibility="Collapsed">
                <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <FontIcon Glyph="&#xE73E;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Button x:Name="RecordButton" Visibility="Collapsed" Height="32" Padding="8,0,16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource RecordRedBrush}" />
                    </Grid>
                    <TextBlock x:Name="RecordLabel" VerticalAlignment="Center" FontSize="14" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="Timer" VerticalAlignment="Center" Visibility="Collapsed" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="Message" VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="Warning" VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <Canvas x:Name="Wave" Height="32" VerticalAlignment="Center" Visibility="Collapsed">
                <Rectangle x:Name="WaveDivider" Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Canvas>

            <Button x:Name="ActionButton" Height="32" Padding="12,0" Visibility="Collapsed" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="SecondButton" Height="32" Padding="12,0" Visibility="Collapsed" VerticalAlignment="Center" />

            <Grid x:Name="MarkArea" Width="32" Height="32" Visibility="Collapsed">
                <Button x:Name="MarkButton" Width="32" Height="32" Padding="0">
                    <FontIcon x:Name="MarkIcon" Glyph="&#xE735;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <InfoBadge x:Name="MarkBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <Button x:Name="StopButton" Width="32" Height="32" Padding="0" Visibility="Collapsed">
                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
            <Button x:Name="HideButton" Width="32" Height="32" Padding="0" Visibility="Collapsed" Click="OnHide"
                    Opacity="0" Scale="0.6,0.6,1" CenterPoint="16,16,0">
                <Button.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.167" />
                </Button.OpacityTransition>
                <Button.ScaleTransition>
                    <Vector3Transition Duration="0:0:0.167" />
                </Button.ScaleTransition>
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
