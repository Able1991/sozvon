<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sozvon.App.Capsule.CapsuleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sozvon">
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          PointerPressed="OnPressed" PointerMoved="OnMoved" PointerReleased="OnReleased"
          PointerEntered="OnEntered" PointerExited="OnExited">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="HideItem" Click="OnHide" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <StackPanel x:Name="Content" Orientation="Horizontal" Spacing="8" Padding="12,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid x:Name="RecordDot" Width="12" Height="12" VerticalAlignment="Center" Visibility="Collapsed">
                <Ellipse Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="1.5" />
                <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
            </Grid>
            <ProgressRing x:Name="Spinner" Width="16" Height="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            <FontIcon x:Name="Check" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" VerticalAlignment="Center" />

            <Button x:Name="RecordButton" Visibility="Collapsed" Style="{StaticResource DefaultButtonStyle}" Height="32" Padding="10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="1.5" />
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Grid>
                    <TextBlock x:Name="RecordLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="Timer" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" />
            <TextBlock x:Name="Message" VerticalAlignment="Center" FontSize="14" Visibility="Collapsed" />
            <Canvas x:Name="Wave" Width="146" Height="28" VerticalAlignment="Center" Visibility="Collapsed" />

            <Button x:Name="ActionButton" Height="32" Padding="10,0" Visibility="Collapsed" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="SecondButton" Height="32" Padding="10,0" Visibility="Collapsed" VerticalAlignment="Center" />

            <Grid x:Name="MarkArea" Visibility="Collapsed" VerticalAlignment="Center">
                <Button x:Name="MarkButton" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="MarkIcon" Glyph="&#xE734;" FontSize="14" />
                </Button>
                <InfoBadge x:Name="MarkBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
            <Button x:Name="StopButton" Width="32" Height="32" Padding="0" Visibility="Collapsed" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
            <Button x:Name="HideButton" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed" VerticalAlignment="Center" Click="OnHide">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
